# Demo works without Earth Engine or MQTT credentials.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/geocool_demo.sqlite
EE_PROJECT_ID=dataset-510306
# Configure one supported Earth Engine auth method outside source control.
GOOGLE_APPLICATION_CREDENTIALS=
MQTT_BROKER=
MQTT_PORT=1883
# Optional public browser key for CartoDB Positron tiles; restrict by Preview/site referrer.
CARTO_API_KEY=
POSTGRES_PASSWORD=geocool_demo
